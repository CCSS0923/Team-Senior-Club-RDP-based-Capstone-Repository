<Window x:Class="EduStream.Client.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="{Binding WindowTitle}"
        Height="720"
        Width="1180"
        MinHeight="640"
        MinWidth="960">
    <Grid Background="#FFF7F8FB">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Margin="24,24,24,12"
                Padding="24"
                Background="White"
                BorderBrush="#FFD8E0EA"
                BorderThickness="1"
                CornerRadius="16">
            <StackPanel>
                <TextBlock FontSize="28"
                           FontWeight="Bold"
                           Text="{Binding HeaderTitle}" />
                <TextBlock Margin="0,10,0,0"
                           Foreground="#FF5B6573"
                           Text="{Binding HeaderDescription}"
                           TextWrapping="Wrap" />
                <Border Margin="0,16,0,0"
                        Padding="14"
                        Background="#FFF4F7FB"
                        BorderBrush="#FFD8E0EA"
                        BorderThickness="1"
                        CornerRadius="10">
                    <TextBlock Text="{Binding StatusSummary}" />
                </Border>
            </StackPanel>
        </Border>

        <Grid Grid.Row="1" Margin="24,12,24,24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="12" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.3*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Row="0"
                    Grid.ColumnSpan="3"
                    Padding="18"
                    Background="White"
                    BorderBrush="#FFD8E0EA"
                    BorderThickness="1"
                    CornerRadius="14">
                <StackPanel>
                    <TextBlock FontSize="18" FontWeight="SemiBold" Text="세션 접속 영역" />
                    <TextBlock Margin="0,8,0,0"
                               Foreground="#FF5B6573"
                               Text="UI 담당이 IP, Port, 이름 입력 UI를 이 영역에 재구성하면 됩니다."
                               TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <Border Grid.Row="2"
                    Grid.Column="0"
                    Padding="18"
                    Background="White"
                    BorderBrush="#FFD8E0EA"
                    BorderThickness="1"
                    CornerRadius="14">
                <StackPanel>
                    <TextBlock FontSize="18" FontWeight="SemiBold" Text="공유 화면 / 다운로드 상태" />
                    <TextBlock Margin="0,8,0,0"
                               Foreground="#FF5B6573"
                               Text="공유 화면 표시 영역, 파일 다운로드 진행률, 연결 상태 등을 이 영역에 배치할 수 있습니다."
                               TextWrapping="Wrap" />
                    <ListBox Margin="0,16,0,0"
                             BorderThickness="0"
                             Background="Transparent"
                             ItemsSource="{Binding LeftPanelNotes}" />
                </StackPanel>
            </Border>

            <Border Grid.Row="2"
                    Grid.Column="2"
                    Padding="18"
                    Background="White"
                    BorderBrush="#FFD8E0EA"
                    BorderThickness="1"
                    CornerRadius="14">
                <StackPanel>
                    <TextBlock FontSize="18" FontWeight="SemiBold" Text="채팅 / 로그 영역" />
                    <TextBlock Margin="0,8,0,0"
                               Foreground="#FF5B6573"
                               Text="채팅 목록, 입력창, 활동 로그 등 텍스트 중심 UI를 이 영역에 배치하면 됩니다."
                               TextWrapping="Wrap" />
                    <ListBox Margin="0,16,0,0"
                             BorderThickness="0"
                             Background="Transparent"
                             ItemsSource="{Binding RightPanelNotes}" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
