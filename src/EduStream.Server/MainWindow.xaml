<Window x:Class="EduStream.Server.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="{Binding WindowTitle}"
        Height="760"
        Width="1280"
        MinHeight="680"
        MinWidth="1080">
    <Grid Background="#FFFAF7F1">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Margin="24,24,24,12"
                Padding="24"
                Background="White"
                BorderBrush="#FFE4D8C2"
                BorderThickness="1"
                CornerRadius="16">
            <StackPanel>
                <TextBlock FontSize="28"
                           FontWeight="Bold"
                           Text="{Binding HeaderTitle}" />
                <TextBlock Margin="0,10,0,0"
                           Foreground="#FF6B6254"
                           Text="{Binding HeaderDescription}"
                           TextWrapping="Wrap" />
                <Border Margin="0,16,0,0"
                        Padding="14"
                        Background="#FFFFF7EA"
                        BorderBrush="#FFE4D8C2"
                        BorderThickness="1"
                        CornerRadius="10">
                    <TextBlock Text="{Binding StatusSummary}" />
                </Border>
            </StackPanel>
        </Border>

        <Grid Grid.Row="1" Margin="24,12,24,24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="12" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.1*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Row="0"
                    Grid.ColumnSpan="3"
                    Padding="18"
                    Background="White"
                    BorderBrush="#FFE4D8C2"
                    BorderThickness="1"
                    CornerRadius="14">
                <StackPanel>
                    <TextBlock FontSize="18" FontWeight="SemiBold" Text="세션 제어 영역" />
                    <TextBlock Margin="0,8,0,0"
                               Foreground="#FF6B6254"
                               Text="세션 이름, 포트, 세션 열기/닫기 버튼을 이 영역에 배치하면 됩니다."
                               TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <Border Grid.Row="2"
                    Grid.Column="0"
                    Padding="18"
                    Background="White"
                    BorderBrush="#FFE4D8C2"
                    BorderThickness="1"
                    CornerRadius="14">
                <StackPanel>
                    <TextBlock FontSize="18" FontWeight="SemiBold" Text="화면 공유 / RDP 영역" />
                    <TextBlock Margin="0,8,0,0"
                               Foreground="#FF6B6254"
                               Text="교수 화면 미리보기, RDP 연동 UI, 화면 송신 상태를 이 영역에 배치하면 됩니다."
                               TextWrapping="Wrap" />
                    <ListBox Margin="0,16,0,0"
                             BorderThickness="0"
                             Background="Transparent"
                             ItemsSource="{Binding LeftPanelNotes}" />
                </StackPanel>
            </Border>

            <Border Grid.Row="2"
                    Grid.Column="2"
                    Padding="18"
                    Background="White"
                    BorderBrush="#FFE4D8C2"
                    BorderThickness="1"
                    CornerRadius="14">
                <StackPanel>
                    <TextBlock FontSize="18" FontWeight="SemiBold" Text="파일 / 채팅 / 로그 영역" />
                    <TextBlock Margin="0,8,0,0"
                               Foreground="#FF6B6254"
                               Text="파일 전송, 공지 채팅, 활동 로그 등 보조 도구를 이 영역에 배치하면 됩니다."
                               TextWrapping="Wrap" />
                    <ListBox Margin="0,16,0,0"
                             BorderThickness="0"
                             Background="Transparent"
                             ItemsSource="{Binding RightPanelNotes}" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
